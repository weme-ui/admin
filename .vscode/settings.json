{
  "js/ts.tsdk.path": "node_modules/@typescript/typescript6/lib",

  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",

  "[vue]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },

  // For generated files
  "files.readonlyInclude": {
    ".weme/*.*": true,
    "**/auto-imports.d.ts": true,
    "**/components.d.ts": true,
    "**/typed-router.d.ts": true
  },
  "files.watcherExclude": {
    ".weme/*.*": true,
    "**/auto-imports.d.ts": true,
    "**/components.d.ts": true,
    "**/typed-router.d.ts": true
  },
  "search.exclude": {
    ".weme/*.*": true,
    "**/auto-imports.d.ts": true,
    "**/components.d.ts": true,
    "**/typed-router.d.ts": true
  },

  // For Tailwind CSS, we can ignore unknown at-rules like @tailwind and @apply.
  "css.lint.unknownAtRules": "ignore"
}
